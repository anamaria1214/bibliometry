  title = {Retrieval-augmented generation for generative artificial intelligence in health care},
  author = {Rui Yang and Yilin Ning and Emilia Keppo and Mingxuan Liu and Chuan Hong and D.S. Bitterman and J. Ong and D. Ting and Nan Liu},
  year = {2025},
  journal = {npj Health Systems},

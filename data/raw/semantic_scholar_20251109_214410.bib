@inproceedings{Kuzlu2023_271,
  title = {The Rise of Generative Artificial Intelligence in Healthcare},
  author = {M. Kuzlu and Zhenxin Xiao and S. Sarp and Ferhat Ozgur Catak and Necip Gurler and Ozgur Guler},
  year = {2023},
  booktitle = {Mediterranean Conference on Embedded Computing},
  abstract = {Generative Artificial Intelligence (GAI) is transforming various fields, including finance, education, marketing, and healthcare. Especially in healthcare, GAI has the potential to revolutionize various aspects, such as medical imaging, drug development, patient care, and treatment planning. Key stakeholders who stand to benefit from these advancements include hospitals, clinics, pharmaceutical companies, medical device manufacturers, and research institutions. However, the implementation of GAI in healthcare presents several challenges, such as ensuring data privacy and security, addressing ethical considerations, maintaining quality and accuracy, adhering to regulatory compliance, and integrating with existing systems. This paper examines the current state of GAI in healthcare, discusses its potential benefits and challenges, and highlights future directions that must be addressed to fully harness the power of GAI in improving patient outcomes and healthcare systems.},
  doi = {10.1109/MECO58584.2023.10155107},
}

@article{Ahn2023_272,
  title = {Development of a case-based nursing education program using generative artificial intelligence},
  author = {Jeonghee Ahn and Hye Ok Park},
  year = {2023},
  journal = {The Journal of Korean Academic Society of Nursing Education},
  abstract = {Purpose: This study aimed to develop a case-based nursing education program using generative artificial intelligence and to assess its usability and applicability in nursing curriculums.Methods: The program was developed by following the five steps of the ADDIE model: analysis, design, development, implementation, and evaluation. A panel of five nursing professors served as experts to implement and evaluate the program.Results: Utilizing ChatGPT, six program modules were designed and developed based on experiential learning theory. The experts’ evaluations confirmed that the program was suitable for case-based learning, highly usable, and applicable to nursing education.Conclusion: Generative artificial intelligence was identified as a valuable tool for enhancing the effectiveness of case-based learning. This study provides insights and future directions for integrating generative artificial intelligence into nursing education. Further research should be attempted to implement and evaluate this program with nursing students.},
  doi = {10.5977/jkasne.2023.29.3.234},
}

@article{Washington2023_273,
  title = {The Impact of Generative Artificial Intelligence on Writer's Self-Efficacy: A Critical Literature Review},
  author = {Jerry Washington},
  year = {2023},
  journal = {Social Science Research Network},
  abstract = {.............................................................................................................................. 5 The Impact of Generative Artificial Intelligence on Writer's Self-Efficacy: A Critical Literature Review............................................................................................................................ 6 Background ......................................................................................................................... 7 Purpose of the Review ........................................................................................................ 9 Definition of Writer's Self-Efficacy ...................................................................................11 Role of Generative AI in Written Communication ........................................................... 12 Importance of Exploring the Relationship between Generative AI and Writer's SelfEfficacy ......................................................................................................................................... 14 Theoretical Framework ..................................................................................................... 16 Bandura's Social Cognitive Theory and Self-Efficacy ................................................. 18 The Role of Technology in Enhancing Self-Efficacy ................................................... 19 Application of Generative AI in Written Communication ............................................ 21 Literature Review.............................................................................................................. 23 Overview of Studies on Generative AI in Written Communication ............................. 25 Research on Natural Language Processing (NLP) and Generative AI ..................... 27 Studies on AI-Based Writing Tools and Their Impact on Writers ............................ 28 Generative AI and Writer's Creativity ........................................................................... 30 AI as a Source of Inspiration and Idea Generation ................................................... 32 Electronic copy available at: https://ssrn.com/abstract=4538043 THE IMPACT OF GENERATIVE ARTIFICIAL INTELLIGENCE ON WRITER'S SELFEFFICACY AI as a Tool for Overcoming Writer's Block ............................................................ 33 AI-Driven Language Enhancement and Writing Assistance ........................................ 35 Grammar and Style Correction Tools ....................................................................... 37 AI-Generated Writing Suggestions and Improvements ............................................ 40 AI and Personalized Writing Guidance ......................................................................... 42 Tailored Writing Feedback and Analysis .................................................................. 44 Customizable AI Writing Coaches ............................................................................ 45 The Psychological Effects of AI Assistance on Writers ................................................ 47 Confidence and Motivation Boost ............................................................................ 49 Perceived Competence and Writing Quality ............................................................. 51 Potential Risks and Challenges of Generative AI in Written Communication ............. 52 Over-reliance on AI and its Impact on Writer's Skills .............................................. 53 Ethical Considerations and the Role of Human Input .............................................. 55 Methodological Approaches in Studying the Impact of Generative AI on Writer's SelfEfficacy ......................................................................................................................................... 57 Experimental Studies .................................................................................................... 58 Surveys and Questionnaires .......................................................................................... 59 Interviews and Qualitative Data Analysis ..................................................................... 60 Discussion ......................................................................................................................... 61 Synthesis of Findings from Literature .......................................................................... 63 Electronic copy available at: https://ssrn.com/abstract=4538043 THE IMPACT OF GENERATIVE ARTIFICIAL INTELLIGENCE ON WRITER'S SELFEFFICACY Theoretical Implications and Insights on Writer's Self-Efficacy .................................. 65 Practical Implications for Writers, Educators, and AI Developers ............................... 66 Limitations of Existing Studies and Future Research Directions ................................. 68 Conclusion ........................................................................................................................ 69 Recapitulation of Key Findings .................................................................................... 70 Significance of Generative AI in Enhancing Writer's Self-Efficacy ............................. 71 The Potential of Generative AI to Revolutionize Written Communication .................. 72 Final Remarks on the Future of Generative AI in Supporting Writers' Self-Efficacy .. 74 Electronic copy available at: https://ssrn.com/abstract=4538043 THE IMPACT OF GENERATIVE ARTIFICIAL INTELLIGENCE ON WRITER'S SELFEFFICACY Abstract This literature review explores the impact of Generative Artificial Intelligence (AI) on a writer's self-efficacy. With the increasing prevalence of AI-powered writing assistance, it is essential to understand how the interaction between Generative AI and writers can influence their confidence, competence, and overall writing experiences. By examining existing studies and research using theoretical frameworks, this review critically assesses the potential implications of Generative AI on writers' perception of their abilities, creativity, and writing quality. The review delves into various facets of the Generative AI-writer relationship, including how AI-driven language enhancement tools aid in overcoming writing challenges, inspiring creativity, and overcoming writer's block. Additionally, the review investigates how personalized AI writing guidance tailored to individual needs can augment a writer's self-perception and performance. The review also acknowledges potential risks and challenges of integrating Generative AI into the writing process, such as over-reliance on AI and ethical considerations in using AI-generated content. By synthesizing existing research findings and discussing theoretical and practical implications, this literature review aims to offer insights that guide writers, educators, and AI developers in optimizing the benefits of Generative AI while addressing its limitations responsibly.},
  doi = {10.2139/ssrn.4538043},
}


@article{Brown2024_126,
  title = {Theory‐Driven Perspectives on Generative Artificial Intelligence in Business and Management},
  author = {Olivia Brown and Robert M. Davison and Stephanie Decker and David A. Ellis and J. Faulconbridge and Julie Gore and Michelle Greenwood and Gazi Islam and Christina Lubinski and Niall G. MacKenzie and Renate Meyer and Daniel Muzio and Paolo Quattrone and M. Ravishankar and T. Zilber and Shuang Ren and R. Sarala and Paul Hibbert},
  year = {2024},
  journal = {British Journal of Management},

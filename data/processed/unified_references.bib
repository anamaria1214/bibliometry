@INPROCEEDINGS{11080765,
  author={Pawar, Vikrant and Raut, Roshani},
  booktitle={2025 3rd International Conference on Self Sustainable Artificial Intelligence Systems (ICSSAS)}, 
  title={Stock Market Sentiment Prediction using Long Short - Term Memory and Generative Adversarial Network}, 
  year={2025},
  volume={},
  number={},
  pages={1506-1510},
  abstract={Stock market is very crucial for the growth of country as well as customers as it gives opportunity to invest and earn. However, it is highly unpredictable because of market sentiments on the social media. However, the results are challenging due to lower temporal depiction and unreliable and lower dataset. This paper presents the long short-term memory (LSTM) for the stock market sentiment prediction (SMSP) and linear regression (LR) for the exact price prediction. The generative adversarial network (GAN) is used for creating the synthetic samples as a part of data augmentation to reduce class imbalance problem. The outcomes are validated on public stock market prediction data and LSTM-GAN resulted in improved overall accuracy of 90.8%, recall of 91.4%, precision of 90.1%, F1-Score of 90.4%, selectivity of 90.1% and negative prediction rate (NPV) of 91.4%. The LSTM provides the precision of 61.6%, recall of 63.6%, F1-score of 62.5%, selectivity of 78.3%, NPV of 79.8% and accuracy of 73.1%.},

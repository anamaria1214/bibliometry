@INPROCEEDINGS{11008137,
  author={Diop, Mouhamadou Mame and Ba, Mamadou and Sylla, Khalifa and Ouya, Samuel},
  booktitle={2025 5th International Conference on Innovative Research in Applied Science, Engineering and Technology (IRASET)}, 
  title={Artificial Intelligence in Cybersecurity: Applications, Challenges, and Future Developments}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Cybersecurity is facing increasingly sophisticated threats, such as ransomware, complex DDoS attacks, and zero-day attacks. These evolving threats reveal the limitations of traditional detection, prevention, and response methods. In this context, the integration of Artificial Intelligence (AI) emerges as a promising solution. Machine Learning (ML) and Deep Learning (DL) algorithms enable enhanced detection of malicious behaviors, real-time anomaly identification, and the anticipation of cyberattacks before they cause significant damage. However, the adoption of AI in cybersecurity introduces new challenges, such as adversarial attacks targeting AI models, the lack of transparency in algorithmic decision-making, and the dependence on data quality. This document reviews the current applications of AI in cybersecurity, highlighting its contributions, limitations, and future perspectives. It also explores emerging solutions to counter zero-day attacks, the development of human-AI collaborative systems for adaptive defense, and the establishment of ethical and regulatory frameworks to ensure the responsible use of AI, aimed at protecting critical systems in the long term against increasingly sophisticated threats.},
  keywords={Deep learning;Ethics;Machine learning algorithms;Reviews;Prevention and mitigation;Denial-of-service attack;Threat assessment;Real-time systems;Ransomware;Artificial intelligence;Artificial Intelligence (AI);Cybersecurity;Adversarial Attacks;Threat Detection;Ethical Frameworks},
  doi={10.1109/IRASET64571.2025.11008137},
  ISSN={},
  month={May},}

@INPROCEEDINGS{10752259,
  author={Jain, Vanshika and Tekwani, Khushi and Kumar, Yogesh},
  booktitle={2024 IEEE Region 10 Symposium (TENSYMP)}, 
  title={Advancement in 3-D Medical Images Using Artificial Intelligence Techniques}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper presents a comprehensive review of recent advancements in 3D medical imaging utilizing artificial intelligence (AI) techniques. The review encompasses various studies focused on different applications and types of 3D medical imaging modalities. The literature review discusses works such as deep learning models for brain tumor segmentation in MRI data, active learning strategies for COVID-19 infection segmentation in CT scans, multi-class point cloud completion networks for cardiac anatomy reconstruction from cine MRI images and deep CNN for total brain volume estimation from 3D ultrasound images, among others. Additionally, the paper includes a detailed analysis of techniques and outcomes, summarized in a table, providing insights into the efficacy of different AI approaches in medical imaging tasks. Moreover, the applications and types of 3D medical imaging modalities discussed in the reviewed studies span across various domains including oncology and surgery.},
  keywords={Image segmentation;Three-dimensional displays;Ultrasonic imaging;Reviews;Magnetic resonance imaging;Volume measurement;Oncology;Artificial intelligence;Medical diagnostic imaging;Image reconstruction;3D medical imaging;Artificial intelligence;Convolutional neural network;Segmentation;Deep learning},

  abstract={The purpose of this research paper is to investigate the incorporation of artificial intelligence (AI) tools into Australian higher education. This study will emphasise the advantages, disadvantages, and ethical repercussions of adopting an "AI-first mindset." This mindset delves into students and faculty, encouraging the use of AI tools for academic research, assessments, and support in educational settings. With the rising use of AI technology by educational institutions to improve learning outcomes, providing personalised student experience and streamline administrative procedures. It is becoming increasingly important to evaluate both the potential benefits and the inherent problems associated with the advent of AI. This research adopts a mixed-methods approach, with quantitative surveys of educators and students used along with qualitative interviews from other stakeholders in the tech industry. The research findings indicate that even though AI tools can improve engagement and efficiency, issues around data privacy, the digital gap, and the possibility of AI bias exist in algorithms. A critical analysis is also performed on the ethical considerations surrounding academic integrity and educators' role in an environment enhanced by artificial intelligence. At the end of the article, recommendations are made for legislative frameworks and best practices that will lead to the appropriate integration of artificial intelligence in higher education. These recommendations will ensure that the advantages are maximised while mitigating the dangers connected with the integration. This research contributes to the changing environment of higher education in the digital era and gives insights to institutions striving to create an ethical and inclusive approach to AI deployment.},
  keywords={Surveys;Industries;Ethics;Data privacy;Technological innovation;Generative AI;Education;Stakeholders;Artificial intelligence;Interviews;AI-powered curriculum;Generative AI;Ethical AI integration;Personalized learning;Australian higher education},
  doi={10.1109/EAEEIE65428.2025.11136403},
  ISSN={2472-7687},
  month={June},}

@INPROCEEDINGS{10933164,
  author={Jeniffer, S Benil and Sathya, D and R, Yogeshwari and G, Sukesh and S R, Dhivish Kumar},
  booktitle={2025 4th International Conference on Sentiment Analysis and Deep Learning (ICSADL)}, 
  title={Generative Art: A DC-GAN Approach for Visualizing Descriptions}, 
  year={2025},
  volume={},
  number={},
  pages={996-1001},
  abstract={Text-to-Image Synthesis has gained significant attention due to its ability to generate realistic visuals from textual descriptions. Existing methods, such as Attention-based GAN s and Transformer models, often face challenges in maintaining semantic alignment between text and images, handling complex textual inputs, and ensuring high-quality outputs. To address these limitations, this paper proposes a Deep Convolutional Generative Adversarial Network (DC-GAN) framework leveraging GloVe embeddings for semantic representation. The Oxford 102 Flower dataset, comprising image-text pairs, is used to train and evaluate the model. The DC-GAN architecture includes a generator to synthesize images and a discriminator to validate authenticity, enabling iterative improvement. Evaluation metrics show an average Learned Perceptual Image Patch Similarity (LPIPS) score of 0.286 and a Mean Squared Error (MSE) of 1.455, demonstrating semantic coherence and low pixel-level deviations. Challenges such as refining fine-grained image details and enhancing robustness across diverse datasets persist. This study highlights the potential of DC-GAN for multimodal AI applications, including targeted advertising, virtual reality, and creative design. By advancing text-to-image synthesis, the research provides a robust framework for future exploration in generating semantically consistent and high-quality visuals from text.},
  keywords={Solid modeling;Visualization;Semantics;Text to image;Virtual reality;Coherence;Generative adversarial networks;Transformers;Robustness;Advertising;Text-to-Image Synthesis;Deep Convolutional Generative Adversarial Network (DC-GAN);Global Vectors for Word Representation (Glo Ve) Em b eddings;Learned Perceptual Image Patch Similarity (LPIPS);Mean Squared Error (MSE);Semantic Coherence;Multimodal Artificial Intelligence (AI) Technologies},
  doi={10.1109/ICSADL65848.2025.10933164},
  ISSN={},
  month={Feb},}

@INPROCEEDINGS{11158567,

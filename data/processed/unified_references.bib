  ISSN={2169-3536},
  month={},}

@INPROCEEDINGS{9982780,
  author={Narteni, Sara and Orani, Vanessa and Ferrari, Enrico and Verda, Damiano and Cambiaso, Enrico and Mongelli, Maurizio},
  booktitle={2022 IEEE International Conference on E-health Networking, Application & Services (HealthCom)}, 
  title={A New XAI-based Evaluation of Generative Adversarial Networks for IMU Data Augmentation}, 
  year={2022},

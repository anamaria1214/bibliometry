@ARTICLE{10659323,
  author={Bardhi, Enkeleda and Conti, Mauro and Lazzeretti, Riccardo},
  journal={IEEE Network}, 
  title={Is AI a Trick or T(h)reat for Securing Programmable Data Planes?}, 
  year={2024},
  volume={38},
  number={6},
  pages={146-152},
  abstract={In the Internet of Things era, the Internet demands extremely high-speed communication and data transformation. To this end, the tactile Internet has been proposed as a medium that provides the sense of touch ability, facilitating data transferability with extra-low latency in various applications ranging from industry, robotics, and healthcare to road traffic, education, and culture. Here, programmable networks are role players in approaching the tactile Internet’s low latency (≈ 1ms) pillar. Several functionalities – including security – are offloaded onto the network core employing programmable in-network pipelines. From the security perspective, Artificial Intelligence (AI) is another role player that enables the line-rate inference on the core network without involving the control plane. However, integrating AI-based security solutions in programmable devices is challenging mainly because of their constrained anatomy. Furthermore, such solutions inherit well-known adversarial AI vulnerabilities, representing an additional threat to programmable networks. Considering the above, this article discusses AI-based security solutions in programmable networks, focusing on the explored modalities of integrating AI models in programmable constrained network devices. Moreover, we elaborate on the challenges and risks of relying on AI for such mechanisms. Lastly, the article brings a visionary glimpse for future trends in this regard, raising some essential questions on the indispensability of AI for security functionalities and providing some alternative solutions.},
  keywords={Artificial intelligence;Security;Hardware;Feature extraction;Computer architecture;Tactile Internet;Artificial intelligence;Internet of Things;High-speed networks;Security;Programmable Data Planes;Tactile Internet and Artificial Intelligence},
  doi={10.1109/MNET.2024.3451330},
  ISSN={1558-156X},
  month={Nov},}

@INPROCEEDINGS{10778718,
  author={Hatipoglu, Zehra and Yaman, Busra and Ceylan, Sedanur and Kose, Utku},
  booktitle={2024 Cyber Awareness and Research Symposium (CARS)}, 
  title={Cyber Security Training with Generative Artificial Intelligence Supported Web Platform Using IoT Cyber Threat Scenarios}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Nowadays, IoT devices have a remarkable place in daily life activities. Because of their wide application scope, cyber-attacks have started to increase as causing a critical issue in terms of data security. Because of this, some analyses within IoT network environments should be done for prevention and detection purposes. At this point, it is also important to train users to establish an awareness about cyber threats for IoT and how to analyze network environments in case of unexpected situations. This paper introduces a Web platform, which provides some IoT security scenarios to learn about how to understand / detect cyber threats and test their knowledge. In detail, the platform uses a synthetic dataset of network data pointing malicious or benign network activities. The dataset was generated by Generative Adversarial Networks, which was fed by some original network traffic datasets. Thanks to the synthetic dataset, the platform is able to provide tests or scenarios for randomly chosen network traffic data so that users can learn and test their skills in terms of IoT security. The applications revealed that GAN was successful enough to generate synthetic traffic datasets and the users were positive about their experiences with the developed Web platform.},
  keywords={Training;Knowledge engineering;Generative AI;Prevention and mitigation;Data security;Telecommunication traffic;Generative adversarial networks;Internet of Things;Cyberattack;Synthetic data;IoT;IoT Security;Cyber Security Training;Generative Adversarial Networks;Artificial Intelligence},

  booktitle={2024 International Conference on Communication, Control, and Intelligent Systems (CCIS)}, 
  title={From Manual to Machine: How AI is Redefining Web Scraping for Superior Efficiency: A Literature Review}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={Web Scraping involves the use of bots for the purpose of extracting data from the online web. To extract such data, the web scraper must conduct at least 3 different steps, i.e., collect the necessary links from the web, extract data using the provided links, and save the information in a neatly organized CSV file or database. However, traditional methods to accomplish these steps have faced many difficulties, such as anti-scraping measures and website changes. To tackle these difficulties and to accomplish the steps in a more rapid yet advanced way, Artificial Intelligence (AI) can be utilized. As of mid-2024, the rapid development and improvement of AI has resulted in its integration into many businesses and educational institutions. The current state of AI is remarkably advanced that it can be integrated in about any field and sector available. In this paper, the researcher defined the term Web Scraping, Artificial Intelligence, Natural Language Processing, and Machine Learning, explained the use of AI in Web Scraping including its importance and potential, and the understanding of ethical web scraping practices. This literature review indicated that the integrated use of AI improves the performance of Web Scraping compared to traditional methods.},
  keywords={Ethics;Law;Machine learning;Data collection;Natural language processing;Data mining;Artificial intelligence;General Data Protection Regulation;Systematic literature review;Business;Web Scraping;Artificial Intelligence;Natural Language Processing;Machine Learning;Legal;Ethical},
  doi={10.1109/CCIS63231.2024.10931912},
  ISSN={},
  month={Dec},}

@INPROCEEDINGS{10748039,
  author={Elhayany, Mohamed and Swope, John and Rushe, Shannon and Meinel, Christoph},
  booktitle={2024 IEEE Digital Education and MOOCS Conference (DEMOcon)}, 
  title={AI-Powered MicroApps for Online Assessments: Impacts on Efficiency, Quality, and Future Directions}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In the evolving landscape of educational technology, integrating Artificial Intelligence (AI) into educational assessment creation has emerged as a key area of innovation. This paper compares three methods for generating Multiple Choice Questions (MCQs): (1) without the use of generative AI, (2) with unguided usage of ChatGPT, and (3) with a specialized AI-powered micro-app designed specifically for MCQ generation. The micro-app, named the "MCQ Generator", allows users to set preferences such as difficulty level, number of distractors, and inclusion of hints/feedback, tailoring the final prompt based on these selections. Our study involves instructional designers creating MCQs for hypothetical courses, with educators then evaluating the quality of these questions using a rubric-based approach. The results reveal that AI-assisted methods significantly enhance the efficiency and quality of MCQ generation compared to non-AI methods. Notably, the micro-app demonstrates potential advantages over ChatGPT, offering a more user-friendly interface and a lower barrier to entry for educators. These findings suggest that while ChatGPT can enhance the MCQ creation process, AI micro-apps may provide more tailored functionalities that further streamline educators’ workflows. This paper presents empirical evidence on the utility of AI in educational content development. By doing so, it contributes to the broader discourse on the transformative potential of AI in educational assessment, with a particular focus on online education. Additionally, it explores methods to increase AI adoption within the field.},
  keywords={Technological innovation;Computer aided instruction;Electronic learning;Generative AI;Chatbots;Generators;Artificial intelligence;AI-Powered Micro-Apps;GPT-3.5;Artificial Intelligence;Online Education;Assessment},
  doi={10.1109/DEMOcon63027.2024.10748039},
  ISSN={},
  month={Oct},}

@INPROCEEDINGS{11104880,
  author={Ahlam, Anabousy and Huda, Shayeb and Hala, Habayib and Nimer, Baya'A and Wajeeh, Daher},
  booktitle={2025 International Conference on Smart Learning Courses (SCME)}, 
  title={Navigating AI Adoption: Challenges and Suggested Solutions for College Lecturers}, 
  year={2025},
  volume={},
  number={},
  pages={23-29},
  abstract={The development of artificial intelligence (AI), particularly generative AI tools, has significantly transformed higher education. This study examined the key challenges encountered by college lecturers in the AI environment and the practical solutions they offered for these challenges. Seventeen heads of departments or academic units from a teacher education college participated in this study. Data were collected through a video-recorded focus group interview and supplemented reports. Data were analyzed inductively using the constant comparison method to identify recurring themes and patterns across the participants. The findings revealed five central challenges faced by college lecturers: (1) Assessment integrity that includes difficulties in verifying student authenticity, increasing plagiarism risks, and diminishing academic originality; (2) AI adoption resistance characterized by reluctance or hesitancy in embracing AI technologies stemming from limited familiarity and a lack of confidence; (3) Pedagogical adaptation imperative that necessitates the revision of instructional methodologies and a redefinition of the lecturer's role in the context of AI integration; (4) Technological literacy disparities that refer to gaps in digital literacy among both faculty and students, compound by unequal familiarity with AI tools; and (5) Limited institutional resources that result in restricted access to advanced AI tools and insufficient professional development opportunities. In response to these challenges, the participants proposed several potential solutions: fostering transparent and ethical student utilization of AI tools, implementing alternative assessment strategies focused on personal and critical thinking skills, enhancing institutional support through ICT centers, offering structured training programs, and ensuring equitable access to AI platforms. So, colleges need to open dialogue and collaboration among faculty members to develop shared guidelines and best practices for the ethical and effective use of AI in academic settings. In addition, teaching should focus more on thinking critically and personal skills, which are especially essential in the AI environment.},
  keywords={Training;Resistance;Ethics;Navigation;Generative AI;Plagiarism;Education;Artificial intelligence;Interviews;Guidelines;Artificial intelligence;Technology in education;Teaching challenges. Higher education},
  doi={10.1109/SCME62582.2025.11104880},
  ISSN={},
  month={July},}


@INPROCEEDINGS{11113583,
  author={Yang, Qin and Lu, Guoqing and Ba, Shen and Cui, Lixuan and Wang, Lu},
  booktitle={2025 International Symposium on Educational Technology (ISET)}, 
  title={Exploring the Effect of Academic Motivation on Learning Outcomes: the Mediating Role of GAI Technology Acceptance}, 
  year={2025},
  volume={},
  number={},
  pages={27-31},
  abstract={Generative Artificial Intelligence (GAI) has the potential to improve learning outcomes, which has aroused great interest in the field of education. However, few studies have explored the relationship between learning motivation, GAI technology acceptance, and learning outcomes. A total of 313 pre-service teachers were recruited at N Normal University in China. Questionnaire methods were used for data collection. The results of the structural equation show that: (1) GAI technology acceptance significantly predicted the learning outcomes, while the GAI use behavior did not. (2) Intrinsic motivation significantly predicted the GAI technology acceptance, while extrinsic motivation did not. (3) GAI technology acceptance plays a mediating role between the relationship of intrinsic motivation and learning outcomes. Based on the results of this study, some suggestions were put forward to improve the learning outcomes of pre-service teachers using GAI technology.},

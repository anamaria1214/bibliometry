@INPROCEEDINGS{11198972,
  author={Dogra, Simran and Lal, Apoorva and Gupta, Vaneeka and Gule, Ganesh and Jaiswal, Ajay Prakash},
  booktitle={2025 World Skills Conference on Universal Data Analytics and Sciences (WorldSUAS)}, 
  title={Ethical Challenges and Creative Opportunities Using Artificial Intelligence for Indian Heritage Art Preservation}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Artificial Intelligence (AI) is increasingly reshaping creative domains, offering new tools for the preservation and reinterpretation of traditional art. This paper examines how generative AI models, specifically CycleGAN and StyleGAN2, interact with Indian folk-art forms such as Madhubani, Warli, Pichwai, and Chamba. These culturally rich art traditions are not just visual expressions but living embodiments of heritage and identity. We implement a mixed-methods approach that integrates deep learning architectures with cultural evaluation to investigate the symbolic accuracy, emotional resonance, and perceptual authenticity of AI-generated artworks. Through technical benchmarking and perceptual surveys involving artisans, designers, and cultural scholars, we identify a nuanced divide: while AI excels at stylistic mimicry, it often fails to capture the emotional depth and symbolic nuances inherent in traditional art. Our findings underscore the dual potential and peril of using AI in cultural preservation—highlighting its usefulness for educational outreach and digital restoration, while also cautioning against the risks of cultural misrepresentation. We advocate for ethically guided, culturally aware AI systems that collaborate with—not replace—human creativity, ensuring respectful engagement with intangible heritage in the digital age.},
  keywords={Surveys;Ethics;Art;Accuracy;Generative AI;Information age;Cultural differences;Global communication;Artificial intelligence;Painting;AI-generated art;Chamba painting;cultural preservation;CycleGAN;ethical AI;generative models;Madhubani art;Pichwai painting;StyleGAN2;Warli art},
  doi={10.1109/WorldSUAS66815.2025.11198972},
  ISSN={},
  month={Aug},}


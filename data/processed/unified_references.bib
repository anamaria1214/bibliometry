  ISSN={},
  month={May},}

@INBOOK{10880611,
  author={Ray, Partha Pratim},
  booktitle={Generative Artificial Intelligence for Biomedical and Smart Health Informatics}, 
  title={Generating Synthetic Medical Dataset Using Generative AI: A Case Study}, 
  year={2025},
  volume={},
  number={},
  pages={259-273},
  abstract={Summary <p>This research paper presents a comprehensive exploration of the generation of synthetic medical datasets, leveraging advanced generative models to produce high&#x2010;quality, privacy&#x2010;preserving synthetic datasets. Specifically, we investigate three distinct models from the Gretel platform: Tabular&#x2010;ACTGAN, Tabular&#x2010;Differential&#x2010;Privacy, and Tabular&#x2010;LSTM, each tailored to address different aspects of tabular data synthesis with a focus on healthcare data. Tabular&#x2010;ACTGAN excels in generating numerical data with high column counts and unique categorical fields, offering conditional data generation capabilities. Tabular&#x2010;Differential&#x2010;Privacy provides strong differential privacy guarantees, making it ideal for datasets with categorical variables and ensuring individual privacy in the generated data. Tabular&#x2010;LSTM supports a wide range of data types and introduces automatic data semantic validation to ensure the fidelity and utility of the synthetic data. This study finds that Tabular&#x2010;Differential&#x2010;Privacy outperforms other two models scoring 6 out of 10. It also outshines others by scoring 92% in the synthetic data quality score. Tabular&#x2010;ACTGAN is best when measured against principal component stability, scoring 100%. Tabular&#x2010;LTSM scores 91% for field correlation stability.</p>},
  keywords={Data models;Training;Synthetic data;Ethics;Differential privacy;Training data;Medical services;Generative adversarial networks;Generative AI;Complexity theory},
  doi={10.1002/9781394280735.ch13},
  ISSN={},
  publisher={IEEE},
  isbn={9781394280728},
  url={https://ieeexplore.ieee.org/document/10880611},}


@INPROCEEDINGS{11158480,
  author={Zheng, Guochao and Piao, Jinlong and Zhao, Guohong},
  booktitle={2025 5th International Conference on Artificial Intelligence and Education (ICAIE)}, 
  title={A Practical Study of Applying Generative Artificial Intelligence to Promote Programming Learning Engagement for Middle School Students}, 
  year={2025},
  volume={},
  number={},
  pages={475-479},
  abstract={Programming education has gained prominence in the intelligent era, yet students frequently encounter coding errors and struggle with algorithm comprehension, which diminishes their learning engagement. Although generative AI has brought new vitality to programming instruction, its concrete impacts demand further exploration. This study developed three distinct AI-powered learning strategies - Inquiry Learning, Collaborative Learning and Dialogic Learning - to establish a Generative AI Programming Teaching Model specifically for junior high students. Using a quasi-experimental approach, the research compared the effectiveness of this AI teaching model against traditional methods by implementing them in separate seventh-grade classes at a Y City middle school. The results of the study show that (1) The holistic application of generative AI learning strategies significantly enhanced junior high school students' programming learning engagement. (2) Generative AI learning strategies can enhance middle school students' emotional engagement. (3) Generative AI learning strategies can enhance middle school students' cognitive engagement. (4) Generative AI learning strategies can enhance middle school students' behavioral engagement. The study makes recommendations for the experimental results in order to provide references for improving programming learning engagement.},
  keywords={Generative AI;Federated learning;Education;Urban areas;Learning (artificial intelligence);Encoding;Programming profession;Generative Artificial Intelligence;Programming Education;Learning Engagement},
  doi={10.1109/ICAIE64856.2025.11158480},
  ISSN={},
  month={May},}

@INPROCEEDINGS{10565670,
  author={Muñoz-Mandujano, Martín and Corona, Mauricio Arturo Ibarra and Díaz, José Alejandro Vargas and Corona, Diego Octavio Ibarra and Martínez, Verónica López and Sánchez, Gabriela Pacheco},
  booktitle={2023 XIII International Conference on Virtual Campus (JICV)}, 
  title={Artificial Intelligence and Classrooms: Ethics in the Use of Artificial Intelligence in Education}, 
  year={2023},
  volume={},
  number={},
  pages={1-4},
  abstract={While education and technology currently work hand in hand thanks to educational technology, there's a conflict when students want to use a technology that's prohibited by the teachers, usually because of the implications that a new technology (specifically, artificial intelligence tools) can have in the educational development of the students. In this regard, the present paper seeks to propose and describe the current considerations that need to be considered when including artificial intelligence tools and technologies in educational contexts. From the research, it was identified that it is essential to emphasize that artificial intelligence does not seek to replace teachers, but to complement their work, and that artificial intelligence should be used ethically by students and teachers in ways that result beneficial for teaching and learning alike.},
  keywords={Ethics;Learning (artificial intelligence);Educational technology;Artificial intelligence;artificial intelligence;educational technology;educational challenges;generative adversarial networks;technological inclusion},
  doi={10.1109/JICV59748.2023.10565670},
  ISSN={},

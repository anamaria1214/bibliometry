@INPROCEEDINGS{11189595,
  author={Zhang, Zhiwu},
  booktitle={2025 International Conference on Artificial Intelligence and Digital Ethics (ICAIDE)}, 
  title={The Intersection of Insight Phenomenon in Artificial Intelligence and Kant’s Transcendental Philosophy}, 
  year={2025},
  volume={},
  number={},
  pages={119-125},
  abstract={As artificial intelligence (AI) rapidly developed, the phenomenon of ‘insight’ in AI systems has attracted sufficient research attention. In this study, I principally discuss on the relationship between the insight phenomenon in AI and Kant’s transcendental philosophy and develop a novel theoretical framework for it. This research is an analysis of how such a posteriori structures of Kant’s Transcendental Ideas allow us to understand problems solved by AI systems by analysing the procedural implementation of these systems, and how it, in turn, reveals the profound implication of such ideas on AI cognitive process. In the first step of this paper, the main concept of the insight phenomenon is explained, and then describes its recent applications in AI - as applied in deep learning for example, and natural language processing. Afterwards, it discusses how Kant’s transcendental philosophy can serve as theoretical rationalizations for AI’s abilities of learning, reasoning and innovation especially in building knowledge representation and reasoning frameworks. The final part of the study describes concrete means of applying the Kantian philosophical ideas to the AI system design, introducing new levels of AI optimization. The results indicate that Kant’s a priori framework thus allows to augment the cognitive potential of AI systems and, at the same time, to seed an interdisciplinary dialogue, thereby paving the way to AI’s future development.},
  keywords={Deep learning;Technological innovation;Ethics;Philosophical considerations;Cognitive processes;Knowledge representation;Natural language processing;Artificial intelligence;System analysis and design;Optimization;Artificial Intelligence;Insight Phenomenon;Kant’s Transcendental Philosophy;Cognitive Structure;Reasoning Framework;AI System Design;Interdisciplinary Research},
  doi={10.1109/ICAIDE65466.2025.11189595},
  ISSN={},
  month={May},}


@INPROCEEDINGS{10786623,
  author={Panagoulias, Dimitrios P. and Sotiropoulos, Dionisios and Chrysafiadi, Konstantina and Tsichrintzi, Evangelia-Aikaterini and Sakkopoulos, Evangelos and Tsihrintzis, George A. and Virvou, Maria},

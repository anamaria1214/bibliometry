  title={Transformative Potential and Ethical Challenges: AI Driven Innovations in Cyber Security}, 
  year={2024},
  volume={},
  number={},
  pages={155-160},
  abstract={Since from last decade Artificial Intelligence also considered as AI based technologies emerged as a promising paradigm shift in cyber security, enhancing defense mechanisms against cyber threats. With the help of machine learning based algorithms, neural networks and natural language processing helps to detect the threats and respond with unprecedented speed and accuracy. AI driven solutions offer proactive threat intelligence, enabling organizations to anticipate and mitigate emerging risks in real-time. Concerns related with privacy and ethics are also addressed by the fusion of artificial intelligence with any other technology. Whenever AI is addressed in cyber security in such a way that it can able to find out the challenges associated with it. The challenges and the opportunities associated with the deployment of artificial intelligence into Cybersecurity will be discussed in the paper. In this paper offering insights into its transformative potential and the imperative for responsible implementation will also be discussed. Through a comprehensive analysis of current trends, case studies, and future prospects, this research contributes to a deeper understanding of how AI is reshaping the cyber security landscape, facilitating informed decision making and strategic planning in the face of evolving cyber threats.},
  keywords={Privacy;Ethics;Technological innovation;Neural networks;Organizations;Strategic planning;Real-time systems;Natural language processing;Artificial intelligence;Computer crime;Artificial Intelligence;Cyber Security;Proactive Threat Intelligence;Emerging Risks;Privacy Concerns},
  doi={10.1109/ICACCTech65084.2024.00035},
  ISSN={},
  month={Nov},}

@INPROCEEDINGS{10926941,
  author={Olatunji, Ayobami Peter and Alozie, Emmanuel and Olagunju, Hawau and Udensi, Ferguson},
  booktitle={2024 IEEE 5th International Conference on Electro-Computing Technologies for Humanity (NIGERCON)}, 
  title={A Systematic Review of the Role of Artificial Intelligence in Cybersecurity}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Artificial Intelligence (AI) has become a cornerstone in advancing cybersecurity, offering innovative solutions to detect and mitigate cyber threats. Over the past decade, numerous studies have explored the application of AI, particularly machine learning (ML) and deep learning (DL), in enhancing cybersecurity across various domains such as intrusion detection, malware identification, and phishing prevention. This paper presents a systematic review of AI applications in cybersecurity, covering the period from 2014 to August 2024. The review analyzed literature from five major academic databases—Google Scholar, MDPI, Science Direct, Springer, and IEEE—with a focus on only review papers to gain comprehensive insights into the field. The findings reveal significant progress in deploying AI to counter cyber threats, with notable advances in AI-driven threat intelligence, incident response, and the identification of adversarial ML challenges. However, the review also highlights persistent challenges, including the need for high-quality training datasets, the complexities of emerging threats, and the ethical considerations surrounding AI deployment in cybersecurity.},
  keywords={Training;Support vector machines;Radio frequency;Privacy;Scalability;Prevention and mitigation;Robustness;Computer security;Artificial intelligence;Systematic literature review;Cybersecurity;Cyber-attacks;AI;ML;DL;systematic review},
  doi={10.1109/NIGERCON62786.2024.10926941},
  ISSN={2377-2697},
  month={Nov},}

@INPROCEEDINGS{11131799,
  author={Čišić, Dragan and Drezgić, Saša and Čegar, Saša},
  booktitle={2025 MIPRO 48th ICT and Electronics Convention}, 
  title={A Bibliometric Analysis of Artificial Intelligence in Human-Computer Interaction: Insights from Core Web of Science Literature}, 
  year={2025},
  volume={},
  number={},
  pages={1534-1539},
  abstract={The integration of Artificial Intelligence (AI) into Human-Computer Interaction (HCI) is rapidly evolving, driving significant advancements across various domains. This study presents a comprehensive bibliometric analysis of AI in HCI, based on 149 articles retrieved from the Core Collection of the Web of Science. The analysis explores publication trends, key research themes, influential authors, and emerging areas within the field. Using bibliometric tools, we identify citation networks, co-authorship patterns, and keyword co-occurrence to provide insights into the current research landscape and future directions. The findings highlight the interdisciplinary nature of AI in HCI, showcasing its application in user experience design, adaptive systems, and intelligent interfaces. This study contributes to a deeper understanding of the field's development and offers guidance for researchers and practitioners aiming to leverage AI for enhanced human-computer interactions.},
  keywords={Human computer interaction;Ethics;Reviews;Generative AI;Explainable AI;Bibliometrics;Collaboration;Market research;User experience;Artificial intelligence;AI in HCI;Bibliographic analysis},

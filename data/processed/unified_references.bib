  month={April},}

@INPROCEEDINGS{10932475,
  author={Mazumdar, Bireshwar Dass and Gupta, Prashant K. and Singh, Mohak and Singh, Sujal},
  booktitle={2025 2nd International Conference on Computational Intelligence, Communication Technology and Networking (CICTN)}, 
  title={Towards Designing an Information Superhighway for Neurological Disorders}, 
  year={2025},
  volume={},
  number={},
  pages={318-323},
  abstract={Neurological Disorders impact a subject’s/ person’s nervous system in various ways and include a wide range of neurological conditions. More often than not, the impact is life altering and affects the subject’s communication skills, social interaction capability, etc. If the condition is detected at an early age, it can significantly enhance the quality of life of the subject with focused training, treatment, etc. Detection through brain scans, behavioral analysis, etc. are costly and time consuming. Recently artificial intelligence (AI) models are being increasingly used for detection & classification of neurological disorders based on various parameters and datasets. However, for an end user, it’s still very difficult to realize the power of these models end to end viz., from data acquisition to generating recommendations. Hence, in this paper, we present the architecture of an Information Superhighway in the form of AI pipeline. The task of the Information Superhighway is to enable capturing the multimodal data (image, video, etc.) of a subject from a smartphone of a laptop webcam, and send this through a secure information channel to a cloud storage. On the storage, the data is managed using various Big Data technologies and is acted upon by the DL models. The generated recommendations are sent back through a different secure communication channel back to the mobile or laptop. We feel that our work is first of its kind which makes the technology transfer possible for the end user and utilize full the prowess of powerful AI models.},
  keywords={Neurological diseases;Training;Portable computers;Webcams;Pipelines;Technology transfer;Brain modeling;Nervous system;Data models;Artificial intelligence;Artificial Intelligence;Autism Spectrum Disorder;Deep Learning;Neurological Disorders},
  doi={10.1109/CICTN64563.2025.10932475},
  ISSN={},
  month={Feb},}

@INPROCEEDINGS{10580495,
  author={Ahmad, Khursheed and Rozhok, Anastasiia and Revetria, Roberto},
  booktitle={2024 International Conference on Machine Intelligence and Smart Innovation (ICMISI)}, 
  title={Supply Chain Resilience in SMEs: Integration of Generative AI in Decision-Making Framework}, 
  year={2024},
  volume={},
  number={},
  pages={295-299},
  abstract={Supply chains for Small and medium-sized enterprises (SMEs) are more vulnerable to increasing occurrence of disruption events. These disruptions have a significant impact on their operations’ continuity and performance which results in a loss of customer satisfaction and their market share. Building a resilient SC is a significant challenge for such enterprises due to their limited resources. In this paper, we present the integration of generative AI in a decision-making framework to enhance supply chain resilience (SCR) for SMEs. The ability of Artificial intelligence to generate new scenarios and analyze large data has been integrated at different stages of the decision-making framework. Starting from the initial stage of the framework, AI-generated novel scenarios aid in risk identification. Later, the decision-making framework can get insights from AI in order to trigger optimal mitigation strategies. The AI-integrated framework aims to speed up the decision-making process by identifying, analyzing, and evaluating optimal mitigation strategies to overcome disruption risks and to achieve the objective of SC resilience. Our study provides a practical tool for SMEs to achieve resiliency for their SCs.},
  keywords={Technological innovation;Generative AI;Pandemics;Prevention and mitigation;Decision making;Supply chains;Organizations;decision-making;risk management;supply chain resilience;generative-AI;SMEs},
  doi={10.1109/ICMISI61517.2024.10580495},
  ISSN={},
  month={May},}


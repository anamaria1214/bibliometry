@ARTICLE{10722863,
  author={Xiang, Tian-Yu and Zhou, Xiao-Hu and Xie, Xiao-Liang and Liu, Shi-Qi and Gui, Mei-Jiang and Li, Hao and Huang, De-Xing and Liu, Xiu-Ling and Hou, Zeng-Guang},
  journal={IEEE Transactions on Cybernetics}, 

@INPROCEEDINGS{10692015,
  author={Sharma, Dhruv and Singh, Shuchi and R. Patil, Meenakshi and Subhan, Abdus},
  booktitle={2024 2nd World Conference on Communication & Computing (WCONF)}, 
  title={Medical Image Processing, Disease Prediction and Report Summarization Using Generative Adversarial Networks and AIML}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Imagine if technology could help doctors see clearer and predict diseases earlier. That's what this project is all about. We're combining two powerful technologies, Generative Adversarial Networks (GANs) and Artificial Intelligence and Machine Learning (AIML), to shake up how we handle medical images and reports. First up, we're using GANs to make medical images sharper and more useful. Thinkof it like giving doctors super-clear glasses to spot details that might be hard to see otherwise. Then, we're using AIML to predict diseases by looking at these images and other patient info. It's like having a crystal ball that helps doctors catch problems before they get serious. But that's not all. We're also creating a smart system that writes brief but super-helpfulsummaries of these medical reports. It's like having an assistant who reads all the details and pulls out the most important parts, making it easier for doctors to decide what's next. By bringing together these technologies, we're not just making diagnoses more accurate and predicting diseases sooner, but we're also making sure doctors get the key info they need quickly. It's all about making healthcare smarter and more efficient for everyone involved especially for elderly and especially abled people.},
  keywords={Medical services;Machine learning;Glass;Crystals;Generative adversarial networks;Smart systems;Biomedical image processing;Older adults;Medical diagnostic imaging;Diseases;GANs;ALML;Unsupervised deep learning;Image processing;Medical image translation},
  doi={10.1109/WCONF61366.2024.10692015},
  ISSN={},
  month={July},}

@INPROCEEDINGS{10567144,
  author={Kong, Jiaze and Shen, Xiaobing and Sabariego, Ruth V. and Martinez, Wilmar},
  booktitle={2024 IEEE 10th International Power Electronics and Motion Control Conference (IPEMC2024-ECCE Asia)}, 
  title={Cross-cut heatsink optimization design by applying Conditional Generative Adversarial Network}, 
  year={2024},
  volume={},
  number={},
  pages={4155-4160},
  abstract={Heatsinks have significantly evolved due to demands for larger, cost-effective, and longer-lasting power electronics. Traditional simulation methods for predicting temperatures are time-consuming, requiring complex computations. Artificial Intelligence (AI), particularly Conditional Generative Adversarial Networks (CGaNet), offers a faster, more accurate alternative. CGaNet demonstrated superior temperature prediction accuracy on various datasets, including those outside its training range. The initial training involved a dataset from a cross-cut heatsink, including parameters like pin dimensions, input power, and fan speed. CGaNet predictions for an external dataset showed high conformity to actual data, with the coeffient of determination (R2) of 0.941, surpassing the Feed-forward Neural Network (FNN) in extrapolation ability.},
  keywords={Training;Temperature distribution;Accuracy;Generative adversarial networks;Power electronics;Pins;Heat sinks;Cross-cut heatsink;Conditional Generative Adversarial Network;Feedforward Neural Network;extrapolation;topology optimization;Artificial Intelligent},
  doi={10.1109/IPEMC-ECCEAsia60879.2024.10567144},
  ISSN={},
  month={May},}

@INPROCEEDINGS{10961986,
  author={Leong, Wai Yie},
  booktitle={2025 Joint International Conference on Digital Arts, Media and Technology with ECTI Northern Section Conference on Electrical, Electronics, Computer and Telecommunications Engineering (ECTI DAMT & NCON)}, 
  title={AI-Powered Color Restoration of Faded Historical Paintings}, 
  year={2025},
  volume={},
  number={},
  pages={623-627},
  abstract={The degradation of color in historical paintings poses a significant challenge to art preservation, diminishing the vibrancy and authenticity of masterpieces over time. This paper explores the potential of artificial intelligence (AI) to revolutionize color restoration in historical artworks. By leveraging advanced machine learning techniques, including convolutional neural networks (CNNs) and generative adversarial networks (GANs), AI systems can analyze faded paintings and reconstruct their original hues with unprecedented precision. Using large datasets of high-resolution images, these algorithms learn patterns of pigment degradation and stylistic nuances inherent to specific artists or periods. The study highlights how AI models, trained on multispectral and hyperspectral imaging data, can infer the original color schemes by detecting remnants of pigments invisible to the naked eye. Moreover, AI-driven simulations offer insights into artistic intent and historical contexts, enabling restorers to make informed decisions. This interdisciplinary approach merges art history, chemistry, and computer science, fostering a new era of cultural heritage preservation. The findings underscore AI's transformative role in safeguarding the visual integrity of humanity's artistic legacy while maintaining the ethical considerations of artistic authenticity and conservation standards.},
  keywords={Ethics;Art;Image color analysis;Computational modeling;Imaging;Pigments;Image restoration;Cultural differences;Artificial intelligence;Painting;Color Restoration;Artificial Intelligence;Process Innovation},
  doi={10.1109/ECTIDAMTNCON64748.2025.10961986},
  ISSN={2768-4644},
  month={Jan},}

@INPROCEEDINGS{11158014,
  author={G S, Kishore Kumar and Marappan, Raja},
  booktitle={2025 International Conference on Computing Technologies & Data Communication (ICCTDC)}, 
  title={AI-Driven Approaches for Dynamic Melanoma Progression Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Melanoma, a deadly form of skin cancer, accounts for approximately 60,000 deaths annually worldwide and demands advanced diagnostic and predictive methods to improve patient outcomes and reduce unnecessary biopsies. Recent advancements in Artificial Intelligence (AI), including Generative Adversarial Networks (GANs), hybrid models, and Deep Learning (DL) architectures, have achieved diagnostic accuracies ranging from 90% to 96% in state-of-the-art studies, showcasing significant potential in addressing challenges related to early detection and progression prediction. This research reviews the recent studies focusing on AI techniques for melanoma analysis, discussing their contributions and relevance to a dynamic melanoma progression framework. The key findings of this research reveal that GAN-based methods improve class balance and enhance model training by generating up to 20% more diverse synthetic data, while DL-based models consistently outperform traditional methods in lesion classification. The research synthesizes these insights to propose their integration into a personalized Digital Twin (DT) framework for lesion progression analysis. Additionally, it highlights challenges such as imbalanced datasets in up to 70% of reviewed cases, lack of dynamic simulation models, and the need for personalized treatment optimization while outlining opportunities for future integration of advanced AI methods.},
  keywords={Training;Analytical models;Melanoma;Data models;Numerical models;Digital twins;Lesions;Artificial intelligence;Optimization;Synthetic data;melanoma progression;artificial intelligence;adversarial networks;digital twin;early detection},
  doi={10.1109/ICCTDC64446.2025.11158014},
  ISSN={},
  month={July},}

@INPROCEEDINGS{11099457,
  author={Jiang, Weiwei and Mu, Jianbin and He, Miao and Gu, Weixi and Cheng, Xirong and Azar, Ahmad Taher and Kamal, Nashwa Ahmad},
  booktitle={2025 International Conference on Control, Automation and Diagnosis (ICCAD)}, 
  title={Bankruptcy Prediction with Imbalanced Data and Conditional Generative Adversarial Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The corporate bankruptcy prediction problem remains unresolved, primarily due to the significant class imbalance caused by the rarity of bankruptcy cases in most financial markets. This study addresses the class imbalance challenge using generative artificial intelligence (GAI), employing a conditional generative adversarial network (CTGAN) to generate synthetic data for training machine learning models. Following data augmentation, six representative machine learning models, including Decision Tree (DT), Random Forest (RF), AdaBoost, XGBoost, Artificial Neural Network (ANN), and LightGBM, are evaluated and compared using two real-world datasets from Taiwan and the USA. The CTGAN-based synthetic data generation approach is further compared with alternative methods, including the Synthetic Minority Over-sampling Technique (SMOTE) and Gaussian copula data generators. Experimental results demonstrate that the workflow combining CTGAN and LightGBM achieves the highest prediction performance, measured by F1 score, on both datasets. It also outperforms baseline methods from previous studies, highlighting the effectiveness of GAI in addressing the class imbalance problem in corporate bankruptcy prediction.},
  keywords={Training;Generative AI;Training data;Artificial neural networks;Generative adversarial networks;Generators;Data models;Bankruptcy;Random forests;Synthetic data;Artificial Intelligence;Bankruptcy Prediction;Conditional Generative Adversarial Network;Generative AI},
  doi={10.1109/ICCAD64771.2025.11099457},
  ISSN={2767-9896},
  month={July},}

@INPROCEEDINGS{11199047,
  author={Ganesh, Gule and Ambekar, Shirish and Singh, Arjun Kumar and Das, Amit Kumar and Sanchihar, Manisha},
  booktitle={2025 World Skills Conference on Universal Data Analytics and Sciences (WorldSUAS)}, 
  title={Investigating the Transformative Role of Artificial Intelligence in Enhancing Creativity and Efficiency Across the Graphic Design Process}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Graphic designers are increasingly utilizing AI, resulting in an interactive, customized, and automated creative process. This advancement is mostly driven by change from conventional, labor-intensive methods. This study's primary objective is to investigate how rapid ideation, visual experimentation, and scalable content production enabled by AI platforms such as DALL-E, Midjourney, Runway ML, and Blender are changing the design environment. The growing relationship between human creativity and machine intelligence is investigated in this work using case studies, industry leader interviews, and a comprehensive comparative approach to tool analysis. This course addresses a broad spectrum of topics, including the rising number of hybrid professions in the design sector, the moral conundrums that develop when handling concerns of authenticity and authorship, and the psychological and societal consequences of AI-assisted design. Apart from being a useful tool, the outcomes reveal that artificial intelligence may be a creative partner by questioning established artistic methods and bringing fresh ideas to domains like visual storytelling, branding, and interactive media concept creation.},
  keywords={Visualization;Ethics;Three-dimensional displays;Soft sensors;Psychology;Production;Media;Artificial intelligence;Protection;Creativity;3D Modeling;Adobe Illustrator;Artificial Intelligence;Blender;Creative Automation;DALL·E;Digital Art;Graphic Design;Midjourney;Runway ML},
  doi={10.1109/WorldSUAS66815.2025.11199047},
  ISSN={},
  month={Aug},}

@INPROCEEDINGS{10967941,
  author={Yang, Nan and Dong, Liang and Wei, Yichen and Liu, Xingwei and Chen, Weitong and Zhang, Zhejun and Li, Xinhang and Huang, Yupeng and Li, Lei},
  booktitle={2025 IEEE 8th Information Technology and Mechatronics Engineering Conference (ITOEC)}, 
  title={GARL: A Generative Adversarial Reinforcement Learning for Transferable Power Grid Dispatch}, 
  year={2025},
  volume={8},
  number={},
  pages={1224-1228},
  abstract={This paper proposes a novel deep reinforcement learning approach, named GARL (Generative Adversarial Reinforcement Learning), for intra-day optimization dispatch in high-proportion new energy grid. The proposed method embeds a Generative Adversarial Network (GAN) within the Deep Deterministic Policy Gradient (DDPG) framework to learn the reward distribution of the power grid in the future operation situation, so as to realize the cumulative reward prediction in the dispatching period and ensure the optimization of the dispatching decision. Comprehensive experiments are conducted on the SG-126 power grid simulator under three representative scenarios to evaluate the performance and generalization capability of GARL. The results show that GARL can learn the distribution characteristics of stateaction-reward sequence from historical experience, establish the mapping relationship between current state and future cumulative reward, and improve the accuracy of future power grid operation trend prediction, which is always better than the independent DDPG algorithm. Furthermore, the study explores the potential of transfer learning between scenarios and finds that GARL exhibits a promising generalization capability.},
  keywords={Renewable energy sources;Uncertainty;Transfer learning;Generative adversarial networks;Deep reinforcement learning;Market research;Prediction algorithms;Power grids;Dispatching;Optimization;Deep reinforcement learning;Generative Multiple Adversarial Networks;Power grid dispatch;Renewable energy;Transfer learning;Generalization capability},
  doi={10.1109/ITOEC63606.2025.10967941},
  ISSN={2693-289X},
  month={March},}

@ARTICLE{10852323,
  author={Aldraiweesh, Ahmed A. and Alturki, Uthman},
  journal={IEEE Access}, 
  title={The Influence of Social Support Theory on AI Acceptance: Examining Educational Support and Perceived Usefulness Using SEM Analysis}, 
  year={2025},
  volume={13},
  number={},
  pages={18366-18385},
  abstract={This study investigates factors influencing the acceptance of artificial intelligence (AI) in education, focusing on attitudes and intentions toward its use. Drawing on the Technology Acceptance Model (TAM) and Social Support Theory (SST), the research examines perceived usefulness, ease of use, and support measures, including educational and emotional support. The study was conducted at King Saud University, where it adopted a quantitative approach, collecting data from 350 participants through a structured survey. A final sample of 308 valid responses was analyzed using Structural Equation Modeling (SEM). The findings revealed significant relationships between key constructs: perceived educational support positively influenced perceived usefulness ( $\beta = 0.160$ , p = 0.000) and attitudes toward AI ( $\beta = 0.140$ , p = 0.010). Perceived usefulness ( $\beta = 0.670$ , p = 0.000) and ease of use ( $\beta = 0.330$ , p = 0.000) were strong predictors of positive attitudes, which, in turn, significantly shaped intentions to use AI ( $\beta = 0.760$ , p = 0.000). Emotional support and cognitive support also had notable but mixed effects on perceived usefulness. However, social interaction support and perceived enjoyment did not demonstrate significant influence. These findings highlight the importance of designing AI systems that emphasise usability and provide robust educational and emotional support to enhance acceptance. The study contributes to theory by extending TAM with constructs from SST, offering new insights into AI adoption in academic contexts. Practically, the results guide policymakers and developers in fostering AI acceptance by addressing educational and emotional needs, ensuring effective implementation in higher education.},
  keywords={Artificial intelligence;Education;Generative AI;Chatbots;Solid modeling;Technology acceptance model;Stakeholders;Security;Psychology;Numerical analysis;Artificial intelligence;social support theory;AI adoption frameworks;TAM;educational AI},
  doi={10.1109/ACCESS.2025.3534099},
  ISSN={2169-3536},
  month={},}

@INPROCEEDINGS{11041899,
  author={Pawar, Sowrav Rajendra and Bertia, A.},
  booktitle={2025 Third International Conference on Augmented Intelligence and Sustainable Systems (ICAISS)}, 
  title={Sustainable Cooking with AI: Generative Recipes and Smart Nutrition Assistance}, 
  year={2025},
  volume={},
  number={},
  pages={470-477},
  abstract={Cooking sustainably is key to eco-friendly living and reducing food waste. This paper introduces an AI powered platform that combines food classification, recipe generation and nutrition assistance for sustainable cooking. The platform uses a convolutional neural network (CNN) for Indian food classification, RoboFlow API for international food detection and a GPT based natural language processing (NLP) model for personalized recipe generation. It also has waste tracking and meal planning features to optimize ingredient usage and reduce waste. The system achieved 92% accuracy for Indian food items and was able to detect international food through RoboFlow. The platform generates personalized recipes based on user inputs and available ingredients for both sustainability and healthy eating. An interactive Streamlit app is the user interface for food recognition, recipe generation and sustainability focused meal planning. This system combines AI, APIs and sustainability focused innovations to be a one stop solution for modern eco conscious users.},
  keywords={Waste management;Human computer interaction;Food waste;Technological innovation;Natural language processing;Data models;Planning;Convolutional neural networks;Artificial intelligence;Sustainable development;Sustainable Cooking;Artificial Intelligence;Food Classification;Generative Recipes;Nutrition Assistance;Waste Management},
  doi={10.1109/ICAISS61471.2025.11041899},
  ISSN={},
  month={May},}

@ARTICLE{10747338,
  author={Dhanushkodi, Kavitha and Thejas, S.},
  journal={IEEE Access}, 
  title={AI Enabled Threat Detection: Leveraging Artificial Intelligence for Advanced Security and Cyber Threat Mitigation}, 
  year={2024},
  volume={12},
  number={},
  pages={173127-173136},
  abstract={This comprehensive review examines the role of artificial intelligence (AI) in enhancing threat detection and cybersecurity, focusing on recent advancements and ongoing challenges in this dynamic field. The ability to identify and counteract cybersecurity threats including network breaches, adversarial assaults, and zero-day vulnerabilities has significantly increased with the inclusion of AI, especially machine learning and deep learning techniques. The review underscores the critical role of explainability and resilience in AI models to ensure trustworthiness and reliability in AI-driven security solutions. The studies analyzed span a wide range of sectors, including Industry 5.0, the Internet of Things (IoT), 5G networks, and autonomous vehicles, illustrating AI’s adaptability in tackling unique security issues across these domains. Cutting-edge approaches, such as transformer-based models, federated learning, and blockchain integration, are advancing the development of more robust and real-time threat detection systems. However, challenges persist, particularly in managing large-scale data, enabling real-time processing, and ensuring privacy and security. The review concludes that although substantial progress has been achieved, ongoing research and collaboration are vital to fully harness AI’s potential in securing digital landscapes.},
  keywords={Artificial intelligence;Computer security;Data models;Threat assessment;Adaptation models;Internet of Things;Deep learning;Accuracy;Complexity theory;Analytical models;Intrusion detection;Blockchains;Zero-day vulnerabilities;network intrusion detection;federated learning;blockchain;Internet of Things (IoT);adversarial attacks},

@INPROCEEDINGS{10167327,
  author={Hu, Chonghao and Chen, Yu},
  booktitle={2023 4th International Conference on Computer Vision, Image and Deep Learning (CVIDL)}, 
  title={UGAN-GSAM-IT: Unsupervised Generative Adversarial Network with Generative Self-Attention Method for Image Translation}, 
  year={2023},
  volume={},
  number={},
  pages={75-80},
  abstract={The unsupervised image translation is the core task of computer image processing, spanning a variety of real-world application scenarios, and constitutes an important branch of computer vision research orientations. In image translation tasks with significant geometric variations, conventional image translation algorithms have led to the generation of low-quality images due to unstable training. To address this matter, this paper proposes an unsupervised image translation method that combines a Self-Attention module. Specifically, first, the proposed model constructs the Generative Self-Attention Module and embeds it between the residual blocks and up-sampling in the generator, while inserting it in the discriminator before down-sampling. Then, the number of residual blocks is modified. Finally, a residual attention mechanism is introduced in the discriminator, which helps to propagate the features further. In particular, the model enhances the ability of the generator to extract deeper features at the central pixels, further improving the ability to transform the spatial details of the image and guiding the generator to generate more realistic images. Experimental results demonstrate that the proposed model has preferable superiority and performance to the existing unsupervised image translation models.},
  keywords={Training;Deep learning;Computer vision;Computational modeling;Transforms;Computer architecture;Generative adversarial networks;unsupervised learning;generative adversarial network;generative self-attention module;residual attention mechanism;image translation},
  doi={10.1109/CVIDL58838.2023.10167327},
  ISSN={},
  month={May},}


  author={Mohammadi, Ebrahim and Alizadeh, Mojtaba and Asgarimoghaddam, Mohsen and Wang, Xiaoyu and Simões, Marcelo Godoy},
  journal={IEEE Journal of Emerging and Selected Topics in Industrial Electronics}, 

@INPROCEEDINGS{11104924,
  author={Atrash, Amr Jamal and Atawnih, Abdelrahem and Owda, Amani Yousef},
  booktitle={2025 International Conference on Smart Learning Courses (SCME)}, 
  title={Improving Encryption and Hide Messages Inside Images for Secure Correspondence Using Artificial Intelligence}, 
  year={2025},

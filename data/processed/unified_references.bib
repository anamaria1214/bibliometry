@INPROCEEDINGS{11024985,
  author={Santana-Soriano, Edwin},
  booktitle={2025 Institute for the Future of Education Conference (IFE)}, 
  title={Perception of the Integration of Artificial Intelligence and Other Emerging Technologies in Dominican Education from an Ethical Perspective}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This study presents the results of an analysis on the perception of secondary education teachers in the Dominican Republic regarding the use of emerging technologies, including Artificial Intelligence (AI), in their classroom practices. It also identifies the barriers and ethical risks associated with their integration. An online survey was administered to a sample of 754 teachers, using a questionnaire validated by expert judgment and with high reliability ${(\alpha=0.941)}$. The results showed a high level of adoption of technological tools, with the most commonly used being Quizizz, ChatGPT, Padlet, and Kahoot!. Gamification was perceived as the tool with the greatest benefits for student learning and motivation, while generative AI text raised concerns about its potential negative impact on cognitive development. The lack of access to equipment and resources, as well as the need for teacher training, were identified as the main barriers to implementation. Additionally, ethical concerns related to data privacy and security, especially in the case of generative AI text, were evident. The findings suggest the need for further reflection and discussion on the ethical risks of these technologies within the educational community, as well as the design of policies and teacher training programs that promote their effective and responsible use.},
  keywords={Training;Surveys;Ethics;Data privacy;Generative AI;Media;Chatbots;Reflection;Security;Reliability;Artificial Intelligence in Education;Emerging Technologies;Gamification;Educational Ethics;Media Literacy},
  doi={10.1109/IFE63672.2025.11024985},
  ISSN={},
  month={Jan},}

@INPROCEEDINGS{11135610,
  author={Johnson, Judin and K P, Gouri and A K, Aiswarya and A N, Anandhanarayanan and N, Nikhitha},
  booktitle={2025 4th International Conference on Advances in Computing, Communication, Embedded and Secure Systems (ACCESS)}, 
  title={AI-Driven House Plan Generator}, 
  year={2025},
  volume={},
  number={},
  pages={452-457},
  abstract={This work introduces House Plan AI, an AI system that generates 2D house plans automatically from user-specified requirements like room types, spatial relationships, and dimensions. T5 and LLaMA models are used to process natural language inputs, and a Graph Neural Network (GNN) is used to manage the spatial layout of rooms. A Generative Adversarial Network (GAN) produces realistic floor plan images from structured data. The dataset used contains 1500 house plans based on AutoCAD, which were preprocessed by confirming dimensions, eliminating unwanted objects such as furniture, converting to JPG, and resizing to 512×512 via a padding technique. One of the significant features of the system is that it has a cost estimation module in which the Gemini API is employed for the extraction of text and dimension data from uploaded house plans. This information is then utilized to estimate the cost of construction, including items such as steel, RCC belts, rubble work, and fittings, and the results are displayed via a graphical split of costs. A Streamlit-based user interface facilitates login support for users, contractors, and dealers so that they can generate and download plans, see estimates of costs, and allocate work based on reviews. The suggested solution cuts down substantially the time and expense involved in conventional architectural processes, providing a cost-effective, scalable platform for custom home design.},
  keywords={Costs;Reviews;Computational modeling;Estimation;User interfaces;Generative adversarial networks;Feature extraction;Graph neural networks;Steel;Artificial intelligence;T5 and Llama model;GNN model;GAN model;cost estimation;contractor;dealer;review platform},
  doi={10.1109/ACCESS65134.2025.11135610},
  ISSN={},
  month={June},}

@ARTICLE{10787098,
  author={Zhang, Lin and Shao, Zhen and Chen, Bin and Benitez, Jose},
  journal={IEEE Transactions on Engineering Management}, 
  title={Unraveling Generative AI Adoption in Enterprise Digital Platforms: The Effect of Institutional Pressures and the Moderating Role of Internal and External Environments}, 
  year={2025},
  volume={72},
  number={},
  pages={335-348},
  abstract={Despite the transformative potential of generative artificial intelligence (AI) systems within enterprise digital platforms, there still exist gaps in understanding the challenges and strategies associated with their adoption. Addressing this pressing issue, this article draws upon institutional theory to delve into the drivers influencing firms’ adoption of generative AI within their enterprise digital platforms. Leveraging survey data collected from 328 firms that have implemented digital platforms to support their business operations, we find that institutional pressures positively influence generative AI adoption within their enterprise digital platforms. Furthermore, we identify salient moderating effects of policy uncertainty and innovative culture in shaping the relationships. Our research findings make a substantial contribution to AI literature by illuminating the potential challenges and strategies toward generative AI adoption as well as reassessing the application of institutional theory within the digital landscape.},
  keywords={Generative AI;Business;Uncertainty;Artificial intelligence;Industries;Hidden Markov models;Social sciences;Shape;Reviews;Law;Enterprise digital platforms;generative artificial intelligence (AI) adoption;innovative culture;institutional pressures;policy uncertainty},
  doi={10.1109/TEM.2024.3513773},
  ISSN={1558-0040},
  month={},}

@INPROCEEDINGS{10729449,
  author={Zhao, Qi},
  booktitle={2024 IEEE 2nd International Conference on Sensors, Electronics and Computer Engineering (ICSECE)}, 
  title={Research on Intelligent Poster Generation System Integrating Computer Artificial Intelligence Technology for Visual Communication Design}, 
  year={2024},
  volume={},
  number={},
  pages={760-765},
  abstract={This paper aims to explore the application of computer artificial intelligence technology in the field of visual communication design, especially the research and development of intelligent poster generation system. We propose an innovative algorithm that integrates the benefits of variational autoencoders (VAE) and generative adversarial networks (Gans) to enable more efficient and flexible poster design generation. As a powerful generative model, variational autoencoders can generate new samples by learning potential representations of data. The generative adversarial network, with its excellent generative ability and adversarial training mechanism, has made remarkable achievements in the field of image generation. By integrating the two, we have built an intelligent system capable of capturing complex features of poster designs and producing diverse, high-quality posters. In the algorithm implementation, we use variational autoencoder to encode the poster design data and extract the potential feature representation. These features are then fed into a generator in the generative adversarial network to generate a new poster design through adversarial training. At the same time, we designed an efficient loss function to balance the diversity and authenticity of the generated posters. The experimental results show that the algorithm has excellent performance in poster design generation. It can not only generate creative and personalized posters, but also customize the design according to user needs. In addition, the algorithm also shows good generalization ability when dealing with different styles and themes of poster design. In the future, we will continue to optimize algorithms, explore more application scenarios, and promote the deep integration of computer artificial intelligence and visual communication design.},
  keywords={Training;Technological innovation;Visual communication;Image synthesis;Generative adversarial networks;Feature extraction;Generators;Data mining;Intelligent systems;Research and development;Variational autoencoder;Generate adversarial network;Visual communication design;Image generation algorithm},
  doi={10.1109/ICSECE61636.2024.10729449},
  ISSN={},
  month={Aug},}

@INPROCEEDINGS{10986612,
  author={Buvaneshwaran, B. and Ashwin, V. and Abishekrupan, B. S. and Sasidharan, Sandhya and Revathi, K. P.},
  booktitle={2025 3rd International Conference on Disruptive Technologies (ICDT)}, 
  title={AI Driven Restoration of Damaged Paintings and Historical Artifacts Using Generative Adversarial Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1021-1025},
  abstract={Restoration of damaged art pieces, paintings, and artifacts is vital to the preservation of cultural heritage. Conventional techniques are done by hand, hence time-consuming and inconsistent. This paper proposes an AI-based restoration system with Generative Adversarial Networks (GANs) and Context Encoders to automate and improve the restoration process of digital artifacts. The process includes data collection, training, and model optimization to achieve good-quality outputs. The Context Encoder generates predictions for lost parts from adjacent image features, and the GAN model increases texture and color for full integration. The platform is easy to use with convenient uploads and rapid restoration. The model is assessed with quantitative metrics and expert judgment, showing better restoration accuracy. This AI-based solution is a productive and scalable alternative to human restoration and serves museums, historians, and cultural heritage.},
  keywords={Deep learning;Accuracy;Image color analysis;Computational modeling;Generative adversarial networks;Museums;Image restoration;Cultural differences;Optimization;Painting;Image Artifact Restoration;Generative Adversarial Networks (GANs);Digital Image Enhancement;Deep Learning for Restoration;Cultural Heritage Image Restoration},
  doi={10.1109/ICDT63985.2025.10986612},
  ISSN={},
  month={March},}

@INPROCEEDINGS{10595676,
  author={Júunior, Alexandre O. and Calvo-Rolle, José Luis and Leitao, Paulo},
  booktitle={2024 IEEE 33rd International Symposium on Industrial Electronics (ISIE)}, 
  title={Simulation on Digital Twin: Role of Artificial Intelligence and Emergence of Industrial Metaverse}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Digital Twins (DTs) are cutting-edge technological design principles of Industry 4.0. They elevate the representation level of physical systems backed up by accurate real-time data in virtual environments and empower the simulation capabilities of these systems through Artificial Intelligence (AI) for their analysis, monitoring, and optimization. This work comprehensively explores the intrinsic interaction between simulation and AI in DTs, meticulously covering the current literature status and categorizing these symbiotic interactions into three different groups that cover AI to support DT-based simulation, AI for optimization of simulation within DT, and simulation to support AI approaches in DT. In addition, a deeper look is taken at the role of simulation and $A I$ in the emerging concept of the Industrial Metaverse, which promises to extend DTs beyond discrete virtual representation of physical systems to encompass the industrial ecosystem from end-to-end. Finally, the main research challenges for achieving the full integration of simulation and AI in DTs and at the Industrial Metaverse are discussed.},
  keywords={Training;Symbiosis;Production systems;Metaverse;Ecosystems;Real-time systems;Digital twins;Digital Twin;Simulation;Artificial Intelligence;Machine Learning;Industrial Metaverse},
  doi={10.1109/ISIE54533.2024.10595676},
  ISSN={2163-5145},
  month={June},}

@INPROCEEDINGS{10900089,
  author={Xi, Hailong and Ru, Le and Tian, Jiwei and Lu, Bo and Hu, Shiguang and Wang, Wenfei},
  booktitle={2024 4th International Conference on Artificial Intelligence, Robotics, and Communication (ICAIRC)}, 
  title={Adversarial Attacks: Key Challenges for Security Defense in the Age of Intelligence}, 
  year={2024},
  volume={},
  number={},
  pages={41-46},
  abstract={The development of Artificial Intelligence (AI) technology has revolutionized various industries. However, the vulnerability of deep learning models, which are the core technology of AI, has been gradually exposed, among which adversarial attacks have become a prominent security issue. Adversarial attacks pose a threat to the reliability of AI systems by adding tiny perturbations to the input data to mislead the model and lead to wrong prediction results. This paper offers an exhaustive overview of adversarial attacks, encompassing their definitions, taxonomies, and the methodologies for crafting adversarial examples. A comparative analysis of the strengths and weaknesses inherent to different adversarial examples generation techniques is presented, alongside an exposition of their critical influence on the security landscape of deep learning technologies. Finally, the discourse concludes with a prospective outlook on the evolving trends in adversarial attacks.},
  keywords={Deep learning;Perturbation methods;Taxonomy;Predictive models;Market research;Solids;Robustness;Space exploration;Artificial intelligence;Robots;adversarial attacks;adversarial examples;algorithm;security},
  doi={10.1109/ICAIRC64177.2024.10900089},
  ISSN={},
  month={Dec},}

@INPROCEEDINGS{10467441,
  author={Venkatachalam, Nirmala and Rayana, Mukul and S, Bala Vignesh and S, Prathamesh},
  booktitle={2024 2nd International Conference on Intelligent Data Communication Technologies and Internet of Things (IDCIoT)}, 
  title={Voice - Driven Panoramic Imagery: Real-Time Generative AI for Immersive Experiences}, 
  year={2024},
  volume={},
  number={},
  pages={1133-1138},
  abstract={This research study introduces an innovative system that aims to synthesize 360-degree panoramic images in Realtime based on vocal prompts from the user, leveraging state-of-the-art Generative AI with a combination of advanced NLP models. The primary objective of this system is to transform spoken descriptions into immersive and interactive visual scenes, specifically designed to provide users with first-person field views. This cutting-edge technology has the potential to revolutionize the realm of virtual reality (VR) experiences, enabling users to effortlessly create and navigate through personalized environments. The fundamental goal of this system is to enable the generation of real-time images that are seamlessly compatible with VR headsets, offering a truly immersive and adaptive visual experience. Beyond its technological advancements, this research also highlights its significant potential for creating a positive social impact. One notable application lies in psychological interventions, particularly in the context of phobia treatment and therapeutic settings. Here, patients can safely confront and work through their fears within these synthesized environments, potentially offering new avenues for therapy. Furthermore, the system serves educational and entertainment purposes by bringing users' imaginations to life, providing an unparalleled platform for exploring the boundaries of virtual experiences. Overall, this research represents a promising stride towards a more immersive and adaptable future in VR technology, with the potential to enhance various aspects of human lives, from mental health treatment to entertainment and education.},
  keywords={Visualization;Solid modeling;Generative AI;Navigation;Entertainment industry;Medical treatment;Virtual reality;Virtual Reality (VR);Panoramic Images;Voice commands;prompts;Generative Artificial Intelligence (AI);Natural Language Processing (NLP);Immersive Visual Scenes;Psychological Interventions;Phobia Treatment;Real-Time Synthesis;Adaptive Visual Experience;User Interaction;Personalized Environments;Virtual Experiences;VR Headsets;First-Person view},
  doi={10.1109/IDCIoT59759.2024.10467441},
  ISSN={},
  month={Jan},}


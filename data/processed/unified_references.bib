@INPROCEEDINGS{11158117,
  author={Yang, Xiaoyu and Qiao, Xuefeng and Wen, Bingchun},
  booktitle={2025 5th International Conference on Artificial Intelligence and Education (ICAIE)}, 
  title={Beyond the Digital Cave: Reshaping Educational Values and Exploring Practical Pathways in the Era of Generative Artificial Intelligence}, 
  year={2025},
  volume={},
  number={},
  pages={226-230},
  abstract={This study focuses on the value conflicts and practical challenges arising from the application of generative artificial intelligence (AI) in education. Based on Weber's dual framework of instrumental rationality and value rationality, combined with Strauss's metaphor of the “second cave” the study systematically analyzes the profound impact of instrumental rationality on the essence of education. While generative AI offers significant advantages in enhancing teaching effectiveness, optimizing resource allocation, and achieving personalized learning, its overuse may lead to the prioritization of utilitarian educational goals and the mechanization of knowledge transmission. In response to this contradiction, the study proposes a “teacher-AI-student” triadic interaction model, emphasizing that the application of technology should adhere to the principles of assistive, transparent, and inclusive use. Innovatively, the study constructs a differentiated educational strategy based on the “learning ability-willingness matrix”, providing precise personalized support for different learners. In the process of digital transformation in education, it is crucial to fully leverage technological advantages while steadfastly adhering to the humanistic values, thereby achieving a dynamic balance between instrumental rationality and value rationality. The study has important theoretical value and practical significance in advancing educational innovation, deepening educational practice reforms, and building a sustainable technology-empowered education model.},
  keywords={Technological innovation;Philosophical considerations;Generative AI;Instruments;Digital transformation;Education;Buildings;Resource management;Generative Artificial Intelligence;Instrumental Rationality;Value Rationality;Technological Governance;Philosophy of Education},
  doi={10.1109/ICAIE64856.2025.11158117},
  ISSN={},
  month={May},}

@INPROCEEDINGS{11098185,
  author={Laracy, Joseph R. and Kirova, Vassilka D. and Ku, Cyril S. and Marlowe, Thomas J.},
  booktitle={2025 IEEE International Symposium on Ethics in Engineering, Science, and Technology (ETHICS)}, 
  title={Human Dignity and the Ethics of Artificial Intelligence: A Framework for Responsible Design and Use from the Perspective of Catholic Social Teaching}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={The increasing use of artificial intelligence (AI) has brought ethical issues into sharp focus, affecting generative AI, predictive AI, robotics and autonomous devices, and more. In this paper, we examine AI ethical questions from the perspective of Catholic Social Teaching (CST), a framework with philosophical and theological foundations, governing interpersonal interactions and those with the natural world. CST offers a coherent, integrated, and non-utilitarian vision of social ethics, grounded in human dignity and the objective demands of justice and the common good. Other ethical approaches may fragment or relativize these principles, or lack an ultimate grounding for them. Thus, CST has the potential to make a contribution to AI ethics.},
  keywords={Ethics;Grounding;Generative AI;Education;Artificial intelligence;Robots;ethics of artificial intelligence;philosophical ethics;artificial intelligence;Catholic Social Teaching;human dignity},
  doi={10.1109/ETHICS65148.2025.11098185},
  ISSN={2996-3648},
  month={June},}


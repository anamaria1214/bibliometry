@INPROCEEDINGS{8327197,
  author={Lopez-Rincon, Omar and Starostenko, Oleg and Martín, Gerardo Ayala-San},
  booktitle={2018 International Conference on Electronics, Communications and Computers (CONIELECOMP)}, 
  title={Algoritmic music composition based on artificial intelligence: A survey}, 
  year={2018},
  volume={},
  number={},
  pages={187-193},
  abstract={We present a taxonomy of the Artificial Intelligence (AI) methods currently applied for algorithmic music composition. The area known as algorithmic music composition concerns the research on processes of composing music pieces automatically by a computer system. The use of AI for algorithmic music consists on the application of AI techniques as the main tools for the composition generation. There are several models of AI used in music composition such as: heuristics in evolutionary algorithms, neural networks, stochastic methods, generative models, agents, decision trees, declarative programming and grammatical representation. In this survey we present the trending in techniques for automatic music composition. We summarized several research projects of the last seven years and highlight the directions of music composition based on AI techniques.},

  author={Then, Christian and Soewandi, Erickar Jeffry and Danial, Muhammad Fakhri and Achmad, Said and Sutoyo, Rhio},
  booktitle={2023 IEEE 9th Information Technology International Seminar (ITIS)}, 
  title={The Impact of Artificial Intelligence on Art - A Systematic Literature Review}, 

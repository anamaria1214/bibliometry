  author={Patel, Yogesh and Tanwar, Sudeep and Gupta, Rajesh and Bhattacharya, Pronaya and Davidson, Innocent Ewean and Nyameko, Royi and Aluvala, Srinivas and Vimal, Vrince},
  journal={IEEE Access}, 
  title={Deepfake Generation and Detection: Case Study and Challenges}, 
  year={2023},
  volume={11},
  number={},
  pages={143296-143323},
  abstract={In smart communities, social media allowed users easy access to multimedia content. With recent advancements in computer vision and natural language processing, machine learning (ML), and deep learning (DL) models have evolved. With advancements in generative adversarial networks (GAN), it has become possible to create fake images/audio/and video streams of a person or use some person’s audio and visual details to fit other environments. Thus, deepfakes are specifically used to disseminate fake information and propaganda on social circles that tarnish the reputation of an individual or an organization. Recently, many surveys have focused on generating and detecting deepfake images, audio, and video streams. Existing surveys are mostly aligned toward detecting deepfake contents, but the generation process is not suitably discussed. To address the survey gap, the paper proposes a comprehensive review of deepfake generation and detection and the different ML/DL approaches to synthesize deepfake contents. We discuss a comparative analysis of deepfake models and public datasets present for deepfake detection purposes. We discuss the implementation challenges and future research directions regarding optimized approaches and models. A unique case study, IBMM is discussed, which presents a multi-modal overview of deepfake detection. The proposed survey would benefit researchers, industry, and academia to study deepfake generation and subsequent detection schemes.},
  keywords={Deepfakes;Generative adversarial networks;Feature extraction;Artificial intelligence;Convolutional neural networks;Surveys;Fake news;Artificial intelligence;Deepfake generation;Deepfake detection;fake content;generative adversarial networks},
  doi={10.1109/ACCESS.2023.3342107},
  ISSN={2169-3536},
  month={},}@ARTICLE{10579548,
  author={Yang, Yaoqi and Zhang, Bangning and Guo, Daoxing and Du, Hongyang and Xiong, Zehui and Niyato, Dusit and Han, Zhu},
  journal={IEEE Wireless Communications}, 
  title={Generative AI for Secure and Privacy-Preserving Mobile Crowdsensing}, 
  year={2024},
  volume={31},
  number={6},
  pages={29-38},
  abstract={Recently, generative AI has attracted much attention from both academic and industrial fields, due to its potential especially in data generation and synthesis aspects. Simultaneously, secure and privacy-preserving mobile crowdsensing (SPPMCS) has been widely applied in data collection/acquisition due to advantages of low deployment cost, flexible implementation, and high adaptability. Since generative AI can generate new synthetic data to replace the original data to be analyzed and processed, it can lower data attacks and privacy leakage risks for the original data. Therefore, integrating generative AI into SPPMCS is feasible and significant. Moreover, this article investigates an integration of generative AI in SPPMCS, where we present potential research focuses, solutions, and case studies. Specifically, we firstly review the preliminaries for generative AI and SPPMCS, where their integration potential is presented. Then, we discuss research issues and solutions for generative AI-enabled SPPMCS, including security defense against malicious data injection, illegal authorization, malicious spectrum manipulation at the physical layer, as well as privacy protection for data content and terminals' identification and location. Next, we propose a framework for sensing data content protection with generative AI. Simulation results have clearly demonstrated the effectiveness of this framework. Finally, we present major research directions for generative AI-enabled SPPMCS.},
  keywords={Sensors;Generative AI;Artificial intelligence;Data privacy;Security;Wireless sensor networks;Data protection;Synthetic data;Simulation;Physical layer;Object recognition;Crowdsensing},
  doi={10.1109/MWC.004.2400017},
  ISSN={1558-0687},
  month={December},}@INPROCEEDINGS{10724819,
  author={Murugesan, Gopikrishnaa S. and Viswanathan, Shyam A.},
  booktitle={2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)}, 
  title={Enhancing Human-Machine Interaction: A Study on Deployment of LLM and Gen AI Hybrid Models in Responsible Humanoids for Human Assistance}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This study explores the integration of Large Language Models (LLMs) and Generative AI (Gen AI) in humanoid robots to enhance human-machine interaction. The deployment of advanced AI capabilities in humanoids has revolutionized various fields, including healthcare, education, and industry. The study highlights the potential benefits of AI in humanoids for vulnerable populations, such as the elderly and disabled, including companionship, assistance with daily tasks, and improved quality of life. However, it also addresses the ethical considerations and challenges associated with AI deployment, such as job displacement and income inequality. The study emphasizes the importance of responsible AI deployment, advocating for transparency, accountability, and fairness in AI algorithms. Furthermore, the research discusses strategies for maximizing the positive impact of AI deployment while mitigating negative consequences, such as investing in education and training programs and implementing regulations and policies for ethical AI use.},
  keywords={Human computer interaction;Training;Ethics;Computational modeling;Large language models;Humanoid robots;Medical services;Regulation;Artificial intelligence;Older adults;Humanoids;AI Deployment;Large Language Models;Generative AI;Human-Machine Interaction;Vulnerable Populations;Ethical Considerations;Responsible AI},
  doi={10.1109/ICCCNT61001.2024.10724819},
  ISSN={2473-7674},
  month={June},}@INPROCEEDINGS{11086698,
  author={Xin, Chang},
  booktitle={2025 10th International Conference on Intelligent Computing and Signal Processing (ICSP)}, 
  title={Stochastic Reconstruction Of Microstructures Based on Generative Adversarial Network Via Explainable AI System}, 
  year={2025},
  volume={},
  number={},
  pages={1027-1031},
  abstract={Random media are materials with irregular structure and spatial randomness, whose macroscopic properties are usually determined by their internal microstructure. Traditional methods for medium reconstruction are usually based on numerical simulation, but the reconstruction process is not only complicated, but also the achieved reconstruction effect is not good. In recent years, with the rapid development of deep learning, generative models (e.g., Generative Adversarial Networks) have been widely used in reconstructing the microstructure of random media. However, early GANs not only cannot effectively notice the features of the input data, but also the computational and parameter storage costs can be huge during the training process. Therefore, how to compress the training cost without sacrificing the training effect turns out to be an urgent problem. In this paper, we propose a novel 3D stochastic medium reconstruction method (3DESGAN) incorporating an explainable system. 3DESGAN introduces an explainable system into the GANs, which provides "richer" correction feedback from the discriminator to the generator. The results show that the addition of an explainable system can effectively improve the quality of the generated images. In addition, in order to control the stochastic nature of the GANs reconstruction process and enable the user to control the pore distribution characteristics of the microstructure, we adopt a style-based GAN (StyleGAN) approach, which incorporates the porosity in the form of style vectors as conditional data in the training process. Meanwhile, we utilize the attention mechanism of Transformer to enhance the ability of 3DESGAN to extract features from multi-scale training images. By comparing 3DESGAN with traditional numerical generation methods, we demonstrate its advantages in terms of reconstruction quality and efficiency.},
  keywords={Training;Costs;Stochastic processes;Process control;Generative adversarial networks;Feature extraction;Vectors;Random media;Microstructure;Image reconstruction;Random medium;Generative adversarial network;Explainable system},
  doi={10.1109/ICSP65755.2025.11086698},
  ISSN={},
  month={May},}@INPROCEEDINGS{11027862,
  author={Lou, Qianya and Bai, Yang and Ying, Haotian and Cai, Lei and Feng, Xinqi and Zhang, Xusheng},
  booktitle={2024 17th International Symposium on Computational Intelligence and Design (ISCID)}, 
  title={Collaborative Sketching: Human-AI Collaboration Modes for Enhancing Designers’ Performance and Experience in Sketching}, 
  year={2024},
  volume={},
  number={},
  pages={159-162},
  abstract={The rapid development of artificial intelligence (AI) technology is changing the working patterns of designers. AI is becoming a key collaboration partner for designers, supporting them in performing design tasks and inspiring creative thought. Although studies have investigated the collaborative framework between designers and AI, its guidance for specific design practices is limited. This study proposes three designer-AI collaboration modes with typical operable processes during sketching. We conducted a user experiment to compare the effects of different collaboration modes on the quantity, novelty, variety of design outcomes, and the designer’s experience. The results show that the collaboration modes can significantly affect the sketch’s quantity and variety, as well as the designer’s overall satisfaction. Our study focuses on the sketching stage and mainly contributes to bridging the theoretical research and design practice regarding designer-AI collaboration.},
  keywords={Generative AI;Collaboration;Product design;Artificial intelligence;Computational intelligence;design sketching;designer-AI collaboration;generative AI;product design methods},
